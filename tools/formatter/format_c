#!/bin/sh
# C formatter.
#
# Applies the z88dk clang-format style stored next to this script to every
# given file. Standalone options are accepted here, so callers decide the
# clang-format binary; the `formatter` dispatcher only forwards arguments it
# does not use itself.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
me=${0##*/}
style="$script_dir/z88dk-c.clang-format"
clang_format=${CLANG_FORMAT:-clang-format}
check=0
changed=0

usage() {
    cat <<'EOF'
Usage: format_c [OPTIONS] <file-or-directory> [...]

Formats C sources and headers with clang-format and the z88dk-c style stored
in the tools/formatter directory, so the result does not depend on the working
directory.

Options:
  --clang-format PATH   clang-format executable to use. The CLANG_FORMAT
                        environment variable is the default, then clang-format
                        from PATH.
  --style PATH          clang-format style file. Defaults to the bundled
                        z88dk-c.clang-format.
  --check               Do not write files; list files that need formatting
                        and exit with status 1 if there are any.
  -h, --help            Show this help and exit.
  --                    End of options.

Directories are expanded to their immediate *.c and *.h children; explicit
file arguments are processed regardless of extension. Files are rewritten only
when their formatted content differs.
EOF
}

while [ "$#" -gt 0 ]; do
    case $1 in
        --clang-format)
            [ "$#" -ge 2 ] || { printf '%s: --clang-format needs a value\n' "$me" >&2; usage >&2; exit 2; }
            clang_format=$2
            shift 2
            ;;
        --clang-format=*)
            clang_format=${1#*=}
            shift
            ;;
        --style)
            [ "$#" -ge 2 ] || { printf '%s: --style needs a value\n' "$me" >&2; usage >&2; exit 2; }
            style=$2
            shift 2
            ;;
        --style=*)
            style=${1#*=}
            shift
            ;;
        --check)
            check=1
            shift
            ;;
        --options)
            printf '%s\n' 'clang-format' 'style' 'check'
            exit 0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf '%s: unknown option: %s\n' "$me" "$1" >&2
            usage >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ ! -f "$style" ]; then
    printf '%s: missing style: %s\n' "$me" "$style" >&2
    exit 2
fi

if ! command -v "$clang_format" >/dev/null 2>&1; then
    printf '%s: clang-format not found: %s\n' "$me" "$clang_format" >&2
    printf '%s: install it or pass --clang-format PATH\n' "$me" >&2
    exit 2
fi

if [ "$#" -eq 0 ]; then
    printf '%s: no input files\n' "$me" >&2
    usage >&2
    exit 2
fi

workdir=$(mktemp -d "${TMPDIR:-/tmp}/format_c.XXXXXX")
cleanup() {
    rm -rf "$workdir"
}
trap cleanup 0 1 2 15

format_file() {
    out="$workdir/out"
    "$clang_format" --Werror --style="file:$style" "$1" > "$out"
    if cmp -s "$1" "$out"; then
        return 0
    fi
    changed=$((changed + 1))
    if [ "$check" -eq 1 ]; then
        printf '%s: would reformat: %s\n' "$me" "$1"
    else
        cat "$out" > "$1"
    fi
}

for input do
    if [ -d "$input" ]; then
        for pattern in '*.c' '*.h'; do
            for file in "$input"/$pattern; do
                [ -f "$file" ] || continue
                format_file "$file"
            done
        done
    elif [ -f "$input" ]; then
        format_file "$input"
    else
        printf '%s: not found: %s\n' "$me" "$input" >&2
        exit 2
    fi
done

if [ "$check" -eq 1 ]; then
    if [ "$changed" -eq 0 ]; then
        printf '%s: nothing to reformat.\n' "$me"
    else
        printf '%s: %s file(s) need formatting\n' "$me" "$changed"
        exit 1
    fi
else
    printf '%s: formatted %s files.\n' "$me" "$changed"
fi
